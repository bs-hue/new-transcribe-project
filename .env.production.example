# Production environment.
#
#   cp .env.production.example .env.production
#
# Then fill in every value marked REQUIRED. Never commit the filled-in copy —
# .env.production is gitignored for that reason.
#
# Start with:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d

# --- Where it lives -----------------------------------------------------------

# REQUIRED. The domain users will visit, without https:// — its DNS A record
# must already point at this server, or Caddy cannot obtain a certificate.
DOMAIN=research.example.com

# REQUIRED. Let's Encrypt sends certificate-expiry warnings here.
ACME_EMAIL=you@example.com

# --- Core ---------------------------------------------------------------------

# Anything other than "development" enables the production guards, including
# the refusal to start with the shipped JWT signing key.
ENVIRONMENT=production
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------

# Two ways to run the database. Fill in ONE of the following blocks.
#
# --- A. Self-hosted PostgreSQL, in a container beside the app -----------------
#        Used by docker-compose.prod.yml. DATABASE_URL is assembled from these
#        values there, so leave DATABASE_URL blank if you use this option.
#
# REQUIRED for option A. Generate one and never reuse it:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=research_hub
POSTGRES_USER=research_hub

# --- B. Supabase or another hosted PostgreSQL --------------------------------
#        Used by docker-compose.supabase.yml. Leave the POSTGRES_* values above
#        blank and set this instead. See docs/SUPABASE.md for where to find it.
#
# Three things differ from the string Supabase shows you, and all three matter:
#   * the driver must be postgresql+asyncpg://  (not postgresql://)
#   * ?ssl=require must be appended             (Supabase refuses plain traffic)
#   * special characters in the password must be percent-encoded
#     (@ becomes %40, # becomes %23, / becomes %2F)
#
# DATABASE_URL=postgresql+asyncpg://postgres.abcdefgh:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?ssl=require
DATABASE_URL=

# --- Authentication -----------------------------------------------------------

# REQUIRED. At least 32 characters. The app refuses to start without a real one.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# 12 hours. Shorten if you want sessions to expire sooner.
ACCESS_TOKEN_EXPIRE_MINUTES=720

# The first administrator, created on first start while the user table is empty.
# REQUIRED for the initial deploy — without it there is no way in.
# Use a real password manager entry, not a memorable phrase.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Who may create an account.
#   closed   — nobody; an administrator adds accounts. The default.
#   approval — anyone may sign up, and waits for an administrator to let them
#              in. Signing up costs nothing until approved, which is what stops
#              a public sign-up page spending your transcription budget.
#   open     — anyone may sign up and use it immediately. Only sensible once
#              per-account limits exist, because transcription costs money.
REGISTRATION_MODE=closed

# --- Transcription ------------------------------------------------------------

# `sarvam` sends audio to Sarvam AI: fast, strong on Indian languages, and it
# costs money per minute beyond the free allowance. `faster_whisper` runs on
# this server: free and private, but needs real CPU and is several times slower.
TRANSCRIPTION_PROVIDER=sarvam

# REQUIRED when TRANSCRIPTION_PROVIDER=sarvam.
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5

# Used when a job falls back to local transcription, and by `doctor --deep`.
# Turbo is the sane default on a server: near-Large quality at Medium speed.
FASTER_WHISPER_MODEL=large-v3-turbo

# Blank means detect per video. Set to a language code if the content is
# reliably one language — it is the single biggest accuracy win outside English.
TRANSCRIPTION_LANGUAGE=

# --- Limits -------------------------------------------------------------------

# These matter far more on a public deployment than a private one: they are the
# ceiling on what one submission can cost you in CPU time and Sarvam credit.
MAX_VIDEO_DURATION_SECONDS=3600
MAX_VIDEO_FILESIZE_BYTES=1073741824
MAX_URLS_PER_REQUEST=25

# --- Media --------------------------------------------------------------------

WORK_DIR=/data/work
KEEP_MEDIA=false

# Instagram Reels require this, and datacenter IPs are blocked more aggressively
# than home connections. See docs/COOKIES.md. The file must be readable inside
# the container, so put it on the api-data volume.
COOKIES_FILE=

# --- Worker -------------------------------------------------------------------

WORKER_ENABLED=true

# How many videos transcribe at once. With Sarvam this can be higher, since the
# work happens on their hardware. With local transcription, keep it at or below
# (CPU cores / 4) or jobs starve each other.
WORKER_CONCURRENCY=4
JOB_MAX_ATTEMPTS=3
