# ---------------------------------------------------------------------------
# Content Research Hub — configuration
# Copy to .env and edit. Never commit .env.
#
# Version 1 runs entirely on free, open-source software. Nothing below requires
# a paid account.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# SQLite (development, zero setup). Used when running WITHOUT Docker; inside
# Docker the equivalent path on the data volume is used automatically.
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# PostgreSQL (production) — also free and open source:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/research_hub

# Point the Docker stack at a hosted PostgreSQL (Supabase) instead of the local
# SQLite file. Leave blank for normal local development.
#
# Note this is a *different* name from DATABASE_URL above, on purpose: that one
# describes a path on your own machine, and letting it reach the container would
# send it to the wrong file. See docs/SUPABASE.md for how to build this value.
#
# EXTERNAL_DATABASE_URL=postgresql+asyncpg://postgres.abc:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres?ssl=require
EXTERNAL_DATABASE_URL=

# --- Authentication ---------------------------------------------------------
# REQUIRED in production. The app refuses to start with this default unless
# ENVIRONMENT=development. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Creates the first admin account on first startup, when no users exist yet.
# Sign in and change this password, then clear these two lines.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Who may create an account.
#   closed   — nobody; an administrator adds accounts. The default.
#   approval — anyone may sign up, and waits for an administrator to let them
#              in. Signing up costs nothing until approved, which is what stops
#              a public sign-up page spending your transcription budget.
#   open     — anyone may sign up and use it immediately. Only sensible once
#              per-account limits exist, because transcription costs money.
REGISTRATION_MODE=closed

# Comma-separated origins allowed to call the API from a browser.
# Vite dev server runs on 5173; the Docker frontend on 3000.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Speech-to-text ---------------------------------------------------------
# faster_whisper : runs on this machine. Free, private, limited by your CPU.
# sarvam         : Sarvam AI's Saarika, built for Indian languages. Much faster
#                  and better on Hindi and Hinglish — but the audio is uploaded
#                  to a third party, and there is a free allowance rather than
#                  free use. Needs SARVAM_API_KEY below.
#
# Local is the default deliberately. Switching is one word, and the system check
# tells you which one you are on.
TRANSCRIPTION_PROVIDER=faster_whisper

# Only used when TRANSCRIPTION_PROVIDER=sarvam. Free key from sarvam.ai.
SARVAM_API_KEY=
SARVAM_MODEL=saarika:v2.5
# Longest clip sent in one request; longer audio is split and stitched back
# together automatically, so this is a request limit, not a video limit.
SARVAM_MAX_AUDIO_SECONDS=30
SARVAM_TIMEOUT_SECONDS=120

# tiny | base | small | medium | large-v3-turbo | large-v3
# Bigger is more accurate and slower, and downloads once on first use.
# For Hindi and other Indian languages, `base` is not good enough — roughly
# half the words come back wrong.
#
# `large-v3-turbo` is the one to use without a GPU: it keeps most of Large's
# accuracy — including Devanagari output for Hindi — while running roughly five
# times faster, because it decodes with 4 layers instead of 32.
FASTER_WHISPER_MODEL=large-v3-turbo
# auto | cpu | cuda   (cuda needs an NVIDIA GPU, and is much faster)
FASTER_WHISPER_DEVICE=auto
# default | int8 | float16
# `default` now resolves to int8 on a CPU and float16 on a GPU — two to four
# times faster than the float32 the library would otherwise pick, for an
# accuracy difference you cannot hear. Set it explicitly to override.
FASTER_WHISPER_COMPUTE_TYPE=default

# How many CPU cores ONE transcription may use. 0 divides the machine between
# the workers below — two workers each grabbing every core spend their time
# fighting each other and the batch finishes later, not sooner.
FASTER_WHISPER_CPU_THREADS=0
# Wider search: slightly more accurate, slightly slower. 5 is the usual choice.
FASTER_WHISPER_BEAM_SIZE=5
# Transcribe several chunks of one video at the same time rather than one
# after another. Two to four times faster on a CPU for identical output.
# Set to 1 to disable. Lower it if the machine runs short of memory.
FASTER_WHISPER_BATCH_SIZE=8

# Above 1.0 discourages the model from repeating itself. Whisper falls into
# "yaa yaa yaa yaa" loops on Indic audio; this is one of the two guards.
FASTER_WHISPER_REPETITION_PENALTY=1.1

# Brand names, product names and jargon your videos use, comma separated.
# Whisper works from sound alone: a word it has never met becomes whatever it
# sounds nearest to. Naming them fixes exactly that. Editable in the app under
# Settings, so you do not have to come back here per client.
# e.g. black obsidian, tiger eye, rudraksha, Vastu, kundali
TRANSCRIPTION_VOCABULARY=

# The spoken language. A name works as well as a code: Hindi, hi, Marathi, mr,
# English, en, Gujarati, Bengali, Tamil, Telugu, Kannada, Malayalam, Punjabi,
# Urdu. Blank means detect it.
#
# Shipped as Hindi deliberately. Automatic detection decides from the opening
# seconds of the audio, and on a reel that opens with music or one English word
# it picks the wrong language and transcribes the entire video through it —
# which produces Latin-script gibberish rather than an obvious error. Naming the
# language removes that failure. If you mostly research English content, set
# this to `en`; if you research both, blank it and rely on detection.
TRANSCRIPTION_LANGUAGE=hi

# --- System limits (checked before download) --------------------------------
MAX_VIDEO_DURATION_SECONDS=7200
MAX_VIDEO_FILESIZE_BYTES=2147483648
MAX_URLS_PER_REQUEST=50

# --- Media ------------------------------------------------------------------
WORK_DIR=./data/work
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Keep downloaded video/audio after transcription (debugging only).
KEEP_MEDIA=false
# Optional Netscape-format cookies file. Instagram and age-restricted YouTube
# videos generally require this. See docs/COOKIES.md.
COOKIES_FILE=

# --- Worker -----------------------------------------------------------------
WORKER_ENABLED=true
# How many videos transcribe at once. Local transcription is CPU-hungry — on a
# small server, leave this at 1 or 2.
WORKER_CONCURRENCY=2
WORKER_POLL_INTERVAL_SECONDS=2.0
JOB_MAX_ATTEMPTS=3

# --- Frontend ---------------------------------------------------------------
# Read by Vite at build time. The URL the browser uses to reach the API.
# This line is for running the frontend directly (`npm run dev`). Under Docker
# the same value is derived from API_PORT below, so change that one instead.
VITE_API_BASE_URL=http://localhost:8000

# --- Ports (Docker only) -----------------------------------------------------
# Which ports on YOUR machine the app answers on. Change these if starting the
# app fails with "port is already allocated" — 8000 in particular is a popular
# default that other software often claims first.
#
# After changing API_PORT you must run `docker compose up --build`, not just
# `up`: the address is compiled into the web page, so the image is rebuilt.
API_PORT=8000
WEB_PORT=3000
