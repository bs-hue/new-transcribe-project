{
  "version": "2.0.0",
  // Run these from the Command Palette → "Tasks: Run Task".
  // "Setup: install everything" is the one to run first on a new machine.
  "tasks": [
    {
      "label": "Setup: install everything",
      "detail": "One-time setup. Creates the Python environment and installs both halves.",
      "type": "shell",
      "command": "python3 -m venv .venv && .venv/bin/python -m pip install -q --upgrade pip && .venv/bin/pip install -e '.[dev]' && cd ../frontend && npm install",
      "windows": {
        "command": "python -m venv .venv; .venv\\Scripts\\python -m pip install --upgrade pip; .venv\\Scripts\\pip install -e '.[dev]'; cd ..\\frontend; npm install"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Check: can this machine run it?",
      "detail": "Downloads the speech model and transcribes a test clip. Run this before anything else.",
      "type": "shell",
      "command": ".venv/bin/python -m app.cli doctor --deep",
      "windows": { "command": ".venv\\Scripts\\python -m app.cli doctor --deep" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Create my login",
      "detail": "Creates an admin account. You will be prompted for a password.",
      "type": "shell",
      "command": ".venv/bin/python -m app.cli create-user --email ${input:email} --admin",
      "windows": {
        "command": ".venv\\Scripts\\python -m app.cli create-user --email ${input:email} --admin"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "problemMatcher": []
    },
    {
      "label": "Run: backend",
      "type": "shell",
      "command": ".venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "windows": {
        "command": ".venv\\Scripts\\python -m uvicorn app.main:app --reload --port 8000"
      },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run: frontend",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run: the whole app",
      "detail": "Starts both halves together. Then open http://localhost:5173",
      "dependsOn": ["Run: backend", "Run: frontend"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    },
    {
      "label": "Test: backend",
      "type": "shell",
      "command": ".venv/bin/python -m pytest -q",
      "windows": { "command": ".venv\\Scripts\\python -m pytest -q" },
      "options": { "cwd": "${workspaceFolder}/backend" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Test: frontend build",
      "type": "shell",
      "command": "npm run build && npm run lint",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "group": "test",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "id": "email",
      "type": "promptString",
      "description": "Your email address (this becomes your login)",
      "default": "you@youragency.com"
    }
  ]
}
